# Never prefix secrets with VITE_. Restart Node after changes.
APP_PASSWORD=replace-with-a-long-unique-password
APP_ORIGIN=https://chat.example.com
PORT=5173

# Hard cap: reject new messages when full; do not evict existing messages.
MAX_HISTORY_MB=64
MAX_CLIENTS=4

# Optional TURN relay for restrictive networks. Coturn shared-secret credentials
# are generated per authenticated session and expire after 12 hours.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
# Set true to hide participant IP addresses from each other (requires TURN).
RELAY_ONLY=false
