# Never prefix secrets with VITE_. Restart Node after changes.
APP_PASSWORD=replace-with-a-long-unique-password
APP_ORIGIN=https://chat.example.com
PORT=5173

# Hard cap on RAM for messages and files (one 256 MB file needs about 260).
# New messages are rejected when full; existing ones are never evicted.
MAX_HISTORY_MB=512
MAX_CLIENTS=4

# Calls go through this server. Open MEDIA_PORT for UDP and TCP in your
# firewall and router. Browsers connect to MEDIA_ANNOUNCED_ADDRESS, which
# defaults to the IP that APP_ORIGIN's hostname resolves to.
MEDIA_PORT=44444
MEDIA_LISTEN_IP=0.0.0.0
MEDIA_ANNOUNCED_ADDRESS=
