{
    "name": "hush-private-chat",
    "version": "1.0.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "node --env-file=.env --import=tsx server/index.ts --dev",
        "build": "tsc --noEmit && vite build",
        "start": "node --env-file=.env --import=tsx server/index.ts",
        "test": "node --import=tsx --test test/*.test.ts",
        "test:browser": "node --import=tsx test/browser.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write ."
    },
    "dependencies": {
        "express": "^5.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "tsx": "^4.23.15",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.0",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^7.3.0"
    }
}
